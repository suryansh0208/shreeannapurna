# ---------------------------------------------------------------------------
# Shree Annapurna Restaurant & Sweet — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values when the backend is ready.
# When VITE_API_BASE_URL is unset, the site runs on demo/mock data.

# Base URL of your Node.js / Express / MongoDB backend API.
# Example: http://localhost:5000/api
VITE_API_BASE_URL=

# Razorpay PUBLIC key (key_id). NEVER put the secret key in the frontend.
# Get this from your Razorpay dashboard: Settings > API Keys.
VITE_RAZORPAY_KEY_ID=
